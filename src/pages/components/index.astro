---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { getComponents } from '../../lib/components';

const base = import.meta.env.BASE_URL;
const allComponents = await getComponents();
const sectionItems = allComponents.map(c => ({
  href: `${base}/components/${c.id}`,
  label: c.data.draft ? `${c.data.title} (draft)` : c.data.title,
}));
---

<SectionLayout
  title="Components"
  sectionTitle="Components"
  sectionItems={sectionItems}
  current={`${base}/components`}
  breadcrumbs={[
    { href: base, label: 'Home' },
    { label: 'Components' },
  ]}
>
  <h1>Components</h1>
  <p>Components are the building blocks of our design system, providing reusable UI elements that ensure consistency and efficiency across our products.</p>
  <ul>
    {allComponents.map(c => (
      <li><a href={`${base}/components/${c.id}`}>{c.data.title}{c.data.draft && ' (draft)'}</a></li>
    ))}
  </ul>
</SectionLayout>
