---
import { getCollection, render } from 'astro:content';
import ComponentLayout from '../../layouts/ComponentLayout.astro';

export async function getStaticPaths() {
  const components = await getCollection('components');
  return components.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const base = import.meta.env.BASE_URL;
const allComponents = await getCollection('components');
const sectionItems = allComponents.map(c => ({
  href: `${base}/components/${c.id}`,
  label: c.data.title,
}));
const current = `${base}/components/${entry.id}`;
---

<ComponentLayout
  title={entry.data.title}
  description={entry.data.description}
  storybookUrl={entry.data.storybookUrl}
  figmaUrl={entry.data.figmaUrl}
  previewImage={entry.data.previewImage}
  version={entry.data.version}
  lastUpdated={entry.data.lastUpdated}
  platforms={entry.data.platforms}
  anatomy={entry.data.anatomy}
  variants={entry.data.variants}
  behavior={entry.data.behavior}
  bestPractices={entry.data.bestPractices}
  designTokens={entry.data.designTokens}
  accessibility={entry.data.accessibility}
  relatedComponents={entry.data.relatedComponents}
  headings={headings}
  sectionTitle="Components"
  sectionItems={sectionItems}
  current={current}
  breadcrumbs={[
    { href: base, label: 'Home' },
    { href: `${base}/components`, label: 'Components' },
    { label: entry.data.title },
  ]}
>
  <Content />
</ComponentLayout>
