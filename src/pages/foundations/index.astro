---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';

const base = import.meta.env.BASE_URL;
const allFoundations = await getCollection('foundations');
const sectionItems = [
  ...allFoundations.map(f => ({
    href: `${base}/foundations/${f.id}`,
    label: f.data.title,
  })),
  { href: `${base}/tokens/colour`, label: 'Colour' },
];
---

<SectionLayout
  title="Foundations"
  sectionTitle="Foundations"
  sectionItems={sectionItems}
  current={`${base}/foundations`}
  breadcrumbs={[
    { href: base, label: 'Home' },
    { label: 'Foundations' },
  ]}
>
  <h1>Foundations</h1>
  <p>Foundations are the core principles and guidelines that form the basis of our design system, ensuring consistency and efficiency across our products.</p>
  <ul>
    {allFoundations.map(f => (
      <li><a href={`${base}/foundations/${f.id}`}>{f.data.title}</a></li>
    ))}
    <li><a href={`${base}/tokens/colour`}>Colour</a></li>
  </ul>
</SectionLayout>
