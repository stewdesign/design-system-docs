---
import { getCollection, render } from 'astro:content';
import ComponentLayout from '../../layouts/ComponentLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('foundations');
  return pages.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;
const allFoundations = await getCollection('foundations');
const sectionItems = [
  ...allFoundations.map(f => ({
    href: `${base}/foundations/${f.id}`,
    label: f.data.title,
  })),
  { href: `${base}/tokens/colour`, label: 'Colour' },
];
const current = `${base}/foundations/${entry.id}`;
---

<ComponentLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionTitle="Foundations"
  sectionItems={sectionItems}
  current={current}
  breadcrumbs={[
    { href: base, label: 'Home' },
    { href: `${base}/foundations`, label: 'Foundations' },
    { label: entry.data.title },
  ]}
>
  <Content />
</ComponentLayout>
