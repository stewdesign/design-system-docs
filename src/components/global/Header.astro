---
import '../../styles/tokens.css';
import '../../styles/main.scss';
const base = import.meta.env.BASE_URL;
const { title } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — AA Design System</title>
</head>
<header>
  <a href={base}>AA Design System</a>
  <nav>
    <div class="nav-group">
      <span class="nav-group-label">Foundations</span>
      <a href={`${base}/foundations/layout`}>Layout</a>
      <a href={`${base}/tokens/colour`}>Colour</a>
    </div>
    <div class="nav-group">
      <span class="nav-group-label">Components</span>
      <a href={`${base}/components/button`}>Button</a>
      <a href={`${base}/components/radio`}>Radio</a>
      <a href={`${base}/components/checkbox`}>Checkbox</a>
      <a href={`${base}/components/segmented-control`}>Segmented Control</a>
      <a href={`${base}/components/accordion`}>Accordion</a>
    </div>
  </nav>
</header>