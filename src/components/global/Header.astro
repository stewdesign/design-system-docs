---
import '../../styles/tokens.css';
import '../../styles/main.scss';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
const base = import.meta.env.BASE_URL;
const { title, sectionTitle } = Astro.props;
const section = sectionTitle?.toLowerCase();
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — AA Design System</title>
</head>
<PagefindConfig />
<header>
  <nav id="global-nav" aria-label="Main Navigation">
    <a href={base}>Design System</a>

    <button
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label="Open main menu"
    >
      Menu
    </button>

    <div id="primary-menu" class="nav-drawer" aria-hidden="true">
      <ul class="global-links">
        <li><a href={`${base}/foundations`} aria-current={section === 'foundations' ? 'page' : undefined}>Foundations</a></li>
        <li><a href={`${base}/components`} aria-current={section === 'components' ? 'page' : undefined}>Components</a></li>
        <li><a href={`${base}/patterns`} aria-current={section === 'patterns' ? 'page' : undefined}>Patterns</a></li>
      </ul>

      {Astro.slots.has('section-nav') && (
        <div class="mobile-context-nav">
          <slot name="section-nav" />
        </div>
      )}
    </div>
  </nav>

  <button
    id="search-toggle"
    aria-haspopup="dialog"
    aria-controls="search-dialog"
    aria-label="Search"
  >
    Search <kbd>⌘K</kbd>
  </button>

  <div id="search-dialog" class="search-dialog" role="dialog" aria-modal="true" aria-label="Search" aria-hidden="true">
    <div class="search-dialog-backdrop" data-search-dismiss></div>
    <div class="search-dialog-panel">
      <pagefind-searchbox id="search-box"></pagefind-searchbox>
      <button type="button" class="search-dialog-close" data-search-dismiss>Close</button>
    </div>
  </div>
</header>
