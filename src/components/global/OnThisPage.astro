---
// In-page table of contents, built from whichever sections a given page
// actually has data for — not every component has every section.
export interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---
<nav class="on-this-page grid" aria-labelledby="on-this-page-heading">
  <h2 id="on-this-page-heading" class="nested-grid-item-50">On this page</h2>
  <ul class="nested-grid-item-50">
    {sections.map((s) => (
      <li><a href={`#${s.id}`}>{s.label}</a></li>
    ))}
  </ul>
</nav>
